# Safe placeholders only. Put real values in .env.local, never in git.
#
# Web console: open Connectors → "🔑 API Keys" popup to fill these interactively.
# POST /api/keys writes .env.local (localhost only; values never returned).

# Local/cloud key vault gates for web/backend.
CLAWDBOT_VAULT_ENABLED=0
CLAWDBOT_VAULT_ALLOWED_IPS=127.0.0.1
CLAWDBOT_VAULT_TOKEN=replace-with-a-long-random-token

# Optional when serving through a trusted reverse proxy.
CLAWDBOT_TRUST_PROXY_HEADERS=0

# Allow browser-direct Connect from the hosted Cheshire Terminal SPA:
# https://cheshireterminal.ai/zeroclawd  →  http://127.0.0.1:18800
CLAWDBOT_CORS_ORIGINS=https://cheshireterminal.ai
# CLAWDBOT_WEB_PORT=18800

# Direct LLM providers — take priority over the free zkrouter default when set.
# MOONSHOT_API_KEY is first priority and defaults the agent to Kimi K3.
# Get a key: https://platform.kimi.ai/console/api-keys
MOONSHOT_API_KEY=
# Optional Moonshot overrides (defaults: kimi-k3 @ https://api.moonshot.ai/v1, effort=max)
# MOONSHOT_MODEL=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_REASONING_EFFORT=max
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=poolside/laguna-s-2.1:free
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Skill / agent catalog roots (path-relative; no host-specific defaults required)
# Bundled open Robinhood/EVM pack lives at ./skills — anyone can use it.
# CLAWDBOT_SKILLS_DIR=./skills
# CLAWDBOT_MERGE_BUNDLED_SKILLS=1
# CLAWDBOT_AGENTS_DIR=
# CLAWDBOT_ZK_PRIMITIVES_DIR=./zk-primitives

# Solana / market data
# SOLANA_RPC_URL=
HELIUS_API_KEY=
BIRDEYE_API_KEY=
JUPITER_API_KEY=
DFLOW_API_KEY=
# PHOENIX_API_URL=https://perp-api.phoenix.trade
ASTER_API_KEY=
ASTER_API_SECRET=

# Robinhood Chain (4663) — required for omni launch / deploy / Pons + Uniswap trade
# Free PRO key: https://dev.blockscout.com  (format: proapi_…)
# Also powers Blockscout MCP (https://mcp.blockscout.com/mcp) via header
# Blockscout-MCP-Pro-Api-Key — see skill blockscout-analysis + GET /api/mcp/blockscout
# Public RPC is a read-only fallback when RH_RPC_URL is unset — not deploy-safe.
BLOCKSCOUT_API_KEY=
RH_RPC_URL=
# Optional overrides (defaults: chain 4663, https://api.blockscout.com)
# RH_CHAIN_ID=4663
# BLOCKSCOUT_BASE_URL=https://api.blockscout.com
# BLOCKSCOUT_PRO_API_KEY=          # alias if BLOCKSCOUT_API_KEY unset
# BLOCKSCOUT_MCP_URL=https://mcp.blockscout.com/mcp

# Channels / browsers / compute
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# Browser Use Cloud — bu_… key; header X-Browser-Use-API-Key
# Alias: BROWSER_USE_API_KEY (canonical in Next.js / zero-service)
BROWSERUSE_API_KEY=
# BROWSER_USE_API_KEY=
KERNEL_API_KEY=
E2B_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
